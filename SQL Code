----- Top 5 Countries by Number of Unicorns------
Select count(country), country from unicorns group by country order by count(country) desc; 

----- Top 3 Countries by Average Valuation 
select country, avg(Post_Money_Value_B) from unicorns group by country order by avg(Post_Money_Value_B) desc limit 3;

----- Most Common Investors
Select count(Lead_Investors_Include), Lead_Investors_Include from unicorns group by Lead_Investors_Include order by count(Lead_Investors_Include) desc limit 5;

----- Total Valuation of unicorns in specific countries -----
select count(company), country, sum(Post_Money_Value_B) from unicorns group by country order by sum(Post_Money_Value_B) desc;
